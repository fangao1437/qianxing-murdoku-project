{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtSpecSet (version 1)",
  "type": "object",
  "required": ["version", "templates"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string" },
    "cellTemplatePx": { "const": 108 },
    "source": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["fit", "compress", "hand"] },
        "icon": { "type": "string" },
        "quantize": { "type": "integer", "minimum": 2, "maximum": 64 },
        "size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "std": { "type": "number", "minimum": 0 },
        "mae": { "type": "number", "minimum": 0 }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/templateSpec" }
    }
  },
  "definitions": {
    "layer": {
      "type": "object",
      "required": ["order", "imageId", "color", "w", "h"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "imageId": { "enum": [100001, 100002, 100003, 107102, 106056] },
        "color": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 240 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 240 },
        "dx": { "type": "number" },
        "dy_down": { "type": "number" },
        "y_up": { "type": "number" },
        "rotDeg": { "type": "number" }
      }
    },
    "templateSpec": {
      "type": "object",
      "required": ["template", "kind", "sizePx", "layers"],
      "properties": {
        "template": { "type": "string", "pattern": "^furn\\.[a-z0-9._]+$" },
        "kind": { "enum": ["chair", "plant", "statue", "table", "carpet", "shelf"] },
        "variant": { "type": "string" },
        "sizePx": {
          "type": "array",
          "items": { "type": "integer", "minimum": 16, "maximum": 512 },
          "minItems": 2,
          "maxItems": 2
        },
        "layerCount": { "type": "integer", "minimum": 1 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/layer" }
        }
      }
    }
  }
}
